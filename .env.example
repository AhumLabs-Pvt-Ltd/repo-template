# Copy to .env (pnpm init does this) and fill in what you need.
# .env is git-ignored. Never commit real keys. Keys are read from the
# environment only and are never logged.

# Optional. Bring your own key to enable Claude-backed features.
ANTHROPIC_API_KEY=

# Optional. Bring your own key to enable OpenAI-backed features.
OPENAI_API_KEY=

# Optional. Port for the local HTTP server (default 3000).
PORT=3000
